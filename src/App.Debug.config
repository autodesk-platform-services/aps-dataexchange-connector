<?xml version="1.0"?>
<!--
	XDT transform applied on top of App.config when building Debug.
	Keep this file limited to settings that legitimately differ per build
	configuration (e.g. LogLevel). Do NOT add credential keys here with
	value="" - SetAttributes will overwrite the matching key in App.config
	to an empty string on every build, which silently destroys the
	developer's credentials. Credentials belong in App.config only.
	For more information on app.config transformation visit
	http://go.microsoft.com/fwlink/?LinkId=125889
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
	<appSettings>
		<add key="LogLevel" value="Debug" xdt:Transform="SetAttributes(value)" xdt:Locator="Match(key)" />
	</appSettings>
</configuration>
